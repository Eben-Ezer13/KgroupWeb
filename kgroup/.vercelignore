# =========================================================================
# Fichiers exclus du bundle envoye a Vercel.
#
# Meme syntaxe que .gitignore. Utile surtout pour un deploiement par depot de
# dossier (« Vercel Drop »), qui sinon televerse TOUT le repertoire — y compris
# .env. Le contenu d'un deploiement est consultable depuis le tableau de bord
# (lien « View code ») : un .env qui y monte est un secret expose.
#
# Ce qui doit RESTER, sous peine de casser le build :
#   package.json, scripts/, server/, db/, api/, vercel.json,
#   les pages .html, les .css/.js de la racine, assets/, .env.example
# =========================================================================

# --- Secrets : ne doivent jamais quitter la machine ---
.env
.env.*
!.env.example

# --- Dependances : Vercel les reinstalle depuis package-lock.json ---
node_modules/

# --- Sortie de build : regeneree par `npm run build` sur le serveur ---
dist/

# --- Sans role a l'execution ni au build ---
tests/
legacy/
.git/
.claude/
.vercel/
*.log
