# =========================================================================
# KGROUP — environment variables
# Copy to .env and fill in.  .env is gitignored and must NEVER be committed.
# =========================================================================

# ---- REQUIRED -----------------------------------------------------------

# Neon connection string.
# Neon console -> your project -> Connection Details -> "Pooled connection".
# Keep the ?sslmode=require suffix. This is a database password: it belongs
# here and in your host's env panel only — never in any .js/.html/.md file.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Signing key for session JWTs. At least 32 characters; required in production.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# ---- RECOMMENDED --------------------------------------------------------

# Public URL of the deployed site. Used to build password-reset links and the
# post-OAuth redirect. Falls back to the request's own host when unset.
APP_URL="https://kgroup-gilt.vercel.app/"

# ---- OPTIONAL -----------------------------------------------------------

PORT=3000
NODE_ENV=development

# Serve the HTML files from the Express process too (keeps the API same-origin).
# The serverless entrypoint (api/index.js) forces this to false in production.
SERVE_STATIC=true

# Require users to confirm their email before the first sign-in.
# Leave false unless RESEND_API_KEY is configured, or nobody can get in.
REQUIRE_EMAIL_CONFIRMATION=false

# Password-reset emails (https://resend.com). Without this the reset endpoint
# still succeeds but only logs the link to the server console.
RESEND_API_KEY=""
MAIL_FROM="KGROUP <onboarding@resend.dev>"

# Google sign-in. Without these the Google button reports that it is disabled.
# Authorised redirect URI: {APP_URL}api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Only needed when the API is hosted on a DIFFERENT origin than the pages.
# Comma-separated exact origins; also set CROSS_SITE_COOKIES=true.
CORS_ORIGINS=""
CROSS_SITE_COOKIES=false

# ---- CRM CLIENTS & ANNIVERSAIRES ----------------------------------------

# Secret protegeant POST /api/reminders/run (le balayage des anniversaires).
# Sans lui, le declenchement automatique est desactive.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Fuseau de reference pour les anniversaires et le decoupage mensuel des paies.
APP_TIMEZONE="Africa/Casablanca"

# Indicatif applique aux numeros saisis au format national (0X...).
DEFAULT_COUNTRY_CODE="212"

# Session lifetime in days, and bcrypt cost.
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=10

# Max pooled Postgres connections per process (keep small on serverless).
PG_POOL_MAX=5

# ---- ONE-OFF DATA MIGRATION ONLY ----------------------------------------
# Direct (non-pooled) Supabase Postgres URL, used by `npm run data:import`.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Delete this line once the import is done.
SUPABASE_DB_URL=""
